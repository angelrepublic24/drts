{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Old site retired: no install needed'",
  "buildCommand": "echo 'Old site retired: redirect only'",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/product/:id", "destination": "https://www.drts.us/product/:id", "permanent": true },
